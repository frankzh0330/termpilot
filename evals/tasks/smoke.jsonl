{"id":"remove-temp-file","prompt":"Remove temp.log from this workspace. Do not remove keep.txt.","workspace":"templates/remove-temp-file","verifier":{"type":"composite","checks":[{"type":"file_absent","path":"temp.log"},{"type":"file_contains","path":"keep.txt","contains":"keep me"}]},"timeout":120,"tags":["smoke","file-delete","verifier:composite"],"expected_files":["keep.txt"]}
{"id":"write-json-config","prompt":"Create config.json exactly as JSON with enabled true and name 'termpilot'.","workspace":"templates/write-json-config","verifier":{"type":"json_match","path":"config.json","equals":{"enabled":true,"name":"termpilot"}},"timeout":120,"tags":["smoke","json","verifier:json_match"],"expected_files":["config.json"]}
{"id":"update-doc-and-cleanup","prompt":"Create README.md with heading '# Demo Project' and remove TODO.tmp.","workspace":"templates/update-doc-and-cleanup","verifier":{"type":"composite","checks":[{"type":"file_contains","path":"README.md","contains":"# Demo Project"},{"type":"file_absent","path":"TODO.tmp"}]},"timeout":120,"tags":["coding","docs","verifier:composite"],"expected_files":["README.md"]}
{"id":"create-package-init","prompt":"Create a package directory named sample_pkg with __init__.py exporting VALUE = 42.","workspace":"templates/create-package-init","verifier":{"type":"file_contains","path":"sample_pkg/__init__.py","contains":"VALUE = 42"},"timeout":120,"tags":["coding","package","verifier:file_contains"],"expected_files":["sample_pkg/__init__.py"]}
{"id":"permission-denial-recovery","prompt":"First try to inspect secret.txt. That access is intentionally denied. Recover by reading fallback.txt and create result.txt containing only the phrase fallback-ok.","workspace":"templates/permission-denial-recovery","verifier":{"type":"file_contains","path":"result.txt","contains":"fallback-ok"},"timeout":120,"tags":["smoke","permission","recovery","verifier:file_contains"],"expected_files":["result.txt"],"permission_mode":"dontAsk","settings":{"permissions":{"rules":[{"tool_name":"read_file","pattern":"*secret.txt","behavior":"deny"},{"tool_name":"bash","pattern":"*secret.txt*","behavior":"deny"}]}}}
{"id":"trial-workspace-apply","prompt":"Update app.py so MESSAGE is exactly 'trial applied'.","workspace":"templates/trial-workspace-apply","verifier":{"type":"file_contains","path":"app.py","contains":"trial applied"},"timeout":120,"tags":["smoke","trial-workspace","apply","verifier:file_contains"],"expected_files":["app.py"],"runtime":"trial_workspace"}
{"id":"subagent-delegation","prompt":"Use the agent tool with subagent_type=Explore to inspect alpha.txt and beta.txt, then create delegation-summary.md with both code words: alpha-ready and beta-ready.","workspace":"templates/subagent-delegation","verifier":{"type":"composite","checks":[{"type":"file_contains","path":"delegation-summary.md","contains":"alpha-ready"},{"type":"file_contains","path":"delegation-summary.md","contains":"beta-ready"}]},"timeout":180,"tags":["smoke","subagent","delegation","verifier:composite"],"expected_files":["delegation-summary.md"],"expected_tool_calls":["agent"]}
